{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Represents a user in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Contact": {
      "title": "Prospect Contact",
      "description": "A target contact for sales outreach.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "company": { "type": "string" },
        "role": { "type": "string" },
        "linkedin": { "type": "string" },
        "phone": { "type": "string" },
        "createdBy": { "type": "string" },
        "researchSummary": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "createdBy", "updatedAt"]
    },
    "Outreach": {
      "title": "Outreach Log",
      "description": "History of communications with a contact.",
      "type": "object",
      "properties": {
        "subject": { "type": "string" },
        "emailBody": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "sent"] },
        "docUrl": { "type": "string" },
        "createdBy": { "type": "string" },
        "contactId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subject", "emailBody", "status", "createdBy", "contactId", "createdAt"]
    },
    "ProspectDiscovery": {
      "title": "Prospect Discovery",
      "description": "Search sessions for finding new prospects.",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "companyUrl": { "type": "string" },
        "linkedinUrl": { "type": "string" },
        "criteria": { "type": "string" },
        "results": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "companyUrl", "createdBy", "createdAt"]
    },
    "Prompt": {
      "title": "System Prompt",
      "description": "Dynamic prompts and templates used by the AI agents.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "template": { "type": "string" },
        "description": { "type": "string" },
        "variables": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "template", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by UID."
    },
    "/contacts/{contactId}": {
      "schema": "Contact",
      "description": "Global contacts collection."
    },
    "/contacts/{contactId}/outreach/{outreachId}": {
      "schema": "Outreach",
      "description": "Outreach logs for a specific contact."
    },
    "/discoveries/{discoveryId}": {
      "schema": "ProspectDiscovery",
      "description": "Prospect discovery sessions."
    },
    "/prompts/{promptId}": {
      "schema": "Prompt",
      "description": "Global AI prompt templates."
    }
  }
}
