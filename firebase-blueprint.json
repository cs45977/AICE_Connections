{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Represents a user in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Contact": {
      "title": "Prospect Contact",
      "description": "A target contact for sales outreach.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "company": { "type": "string" },
        "role": { "type": "string" },
        "linkedin": { "type": "string" },
        "phone": { "type": "string" },
        "createdBy": { "type": "string" },
        "discoveryPersonaId": { "type": "string" },
        "researchSummary": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "createdBy", "updatedAt"]
    },
    "Outreach": {
      "title": "Outreach Log",
      "description": "History of communications with a contact.",
      "type": "object",
      "properties": {
        "subject": { "type": "string" },
        "emailBody": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "sent", "manual", "wont-send"] },
        "docUrl": { "type": "string" },
        "notes": { "type": "string" },
        "hasResponse": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "contactId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subject", "status", "createdBy", "contactId", "createdAt"]
    },
    "ProspectDiscovery": {
      "title": "Prospect Discovery",
      "description": "Search sessions for finding new prospects.",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "companyUrl": { "type": "string" },
        "linkedinUrl": { "type": "string" },
        "criteria": { "type": "string" },
        "results": { "type": "string" },
        "personaId": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "companyUrl", "createdBy", "createdAt"]
    },
    "Prompt": {
      "title": "System Prompt",
      "description": "Dynamic prompts and templates used by the AI agents.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "template": { "type": "string" },
        "description": { "type": "string" },
        "variables": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "template", "updatedAt"]
    },
    "Note": {
      "title": "Contact Note",
      "description": "User notes about a specific contact.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "createdBy": { "type": "string" },
        "contactId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "createdBy", "contactId", "createdAt", "updatedAt"]
    },
    "Persona": {
      "title": "AI Persona",
      "description": "Custom AI persona for a user.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "agentName": { "type": "string" },
        "agentRole": { "type": "string" },
        "agentEmail": { "type": "string" },
        "description": { "type": "string" },
        "customPrompts": {
          "type": "object",
          "properties": {
            "research": { "type": "string" },
            "outreach": { "type": "string" }
          }
        },
        "isDefault": { "type": "boolean" },
        "customDiscoveryRequirements": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdAt"]
    },
    "GlobalSettings": {
      "title": "Global Settings",
      "description": "System-wide configuration settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "defaultDiscoveryRequirements": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "defaultDiscoveryRequirements"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by UID."
    },
    "/users/{userId}/personas/{personaId}": {
      "schema": "Persona",
      "description": "Custom personas for a specific user."
    },
    "/contacts/{contactId}": {
      "schema": "Contact",
      "description": "Global contacts collection."
    },
    "/contacts/{contactId}/outreach/{outreachId}": {
      "schema": "Outreach",
      "description": "Outreach logs for a specific contact."
    },
    "/contacts/{contactId}/notes/{noteId}": {
      "schema": "Note",
      "description": "Notes for a specific contact."
    },
    "/discoveries/{discoveryId}": {
      "schema": "ProspectDiscovery",
      "description": "Prospect discovery sessions."
    },
    "/prompts/{promptId}": {
      "schema": "Prompt",
      "description": "Global AI prompt templates."
    },
    "/settings/{settingId}": {
      "schema": "GlobalSettings",
      "description": "Global system configuration"
    }
  }
}
