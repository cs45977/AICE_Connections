rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 0. Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null; // Relaxing for now as requested "first 3 users no verification" might imply we don't strictly check verified email if we want to honor that limit here too, but let's keep it simple.
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin';
    }

    // --- 1. Users ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == userId &&
               data.uid == request.auth.uid &&
               data.email == request.auth.token.email &&
               data.role in ['user', 'admin'] &&
               data.createdAt is string; 
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName']) && incoming().displayName is string && incoming().displayName.size() <= 100) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role']))
      );
      allow delete: if isAdmin();
    }

    // --- 2. Contacts ---
    match /contacts/{contactId} {
      function isValidContact(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 100 &&
               (data.createdBy == request.auth.uid || isAdmin()) &&
               data.updatedAt is string;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(contactId) && isValidContact(incoming());
      allow update: if isSignedIn() && (
        // Action: Update details
        (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'role', 'linkedin', 'updatedAt', 'company']) && isValidContact(incoming())) ||
        // Action: AI Research Update
        (incoming().diff(existing()).affectedKeys().hasOnly(['researchSummary', 'updatedAt']) && incoming().updatedAt is string) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // --- 3. Outreach Logs (Subcollection) ---
      match /outreach/{outreachId} {
        function isValidOutreach(data) {
          return data.contactId == contactId &&
                 (data.createdBy == request.auth.uid || isAdmin()) &&
                 data.emailBody is string && data.emailBody.size() <= 10000 &&
                 data.status in ['draft', 'sent'];
        }

        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(outreachId) && isValidOutreach(incoming());
        allow update: if isSignedIn() && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'docUrl']) &&
          incoming().status in ['draft', 'sent']) ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // --- 4. Discoveries ---
    match /discoveries/{discoveryId} {
      function isValidDiscovery(data) {
        return data.companyName is string && data.companyName.size() <= 100 &&
               data.companyUrl is string && data.companyUrl.size() <= 200 &&
               data.createdBy == request.auth.uid &&
               data.createdAt is string;
      }

      allow read: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(discoveryId) && isValidDiscovery(incoming());
      allow update: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['criteria', 'results'])
      );
      allow delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // --- 5. Prompts ---
    match /prompts/{promptId} {
      function isValidPrompt(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.template is string && data.template.size() <= 10000 &&
               data.updatedAt is string;
      }

      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidPrompt(incoming());
    }
  }
}
