rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 0. Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null; // Relaxing for now as requested "first 3 users no verification" might imply we don't strictly check verified email if we want to honor that limit here too, but let's keep it simple.
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin';
    }

    // --- 1. Users ---
    match /{path=**}/outreach/{outreachId} {
      allow read: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == userId &&
               data.uid == request.auth.uid &&
               data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
               data.role in ['user', 'admin'] &&
               data.createdAt is string;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'profileUpdated', 'hasSeededStandardAgent'])
        ) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role']))
      );
      allow delete: if isAdmin();

      // --- 1.1 Personas (Subcollection) ---
      match /personas/{personaId} {
        function isValidPersona(data) {
          return data.name is string && data.name.size() <= 100 &&
                 (!data.keys().hasAny(['customDiscoveryRequirements']) || data.customDiscoveryRequirements is string) &&
                 data.createdAt is string;
        }
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(personaId) && isValidPersona(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidPersona(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- 2. Contacts ---
    match /contacts/{contactId} {
      function isValidContact(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 100 &&
               (data.createdBy == request.auth.uid || isAdmin()) &&
               data.updatedAt is string;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(contactId) && isValidContact(incoming());
      allow update: if isSignedIn() && (
        // Action: Update details
        (incoming().diff(existing()).affectedKeys().hasAny(['name', 'email', 'role', 'linkedin', 'updatedAt', 'company', 'phone', 'discoveryPersonaId', 'labels']) && isValidContact(incoming())) ||
        // Action: AI Research Update
        (incoming().diff(existing()).affectedKeys().hasOnly(['researchSummary', 'updatedAt']) && incoming().updatedAt is string) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // --- 2.1 Notes (Subcollection) ---
      match /notes/{noteId} {
        function isValidNote(data) {
          return data.contactId == contactId &&
                 data.createdBy == request.auth.uid &&
                 data.text is string && data.text.size() <= 10000;
        }
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(noteId) && isValidNote(incoming());
        allow update: if isSignedIn() && request.auth.uid == resource.data.createdBy && isValidNote(incoming());
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.createdBy || isAdmin());
      }

      // --- 3. Outreach Logs (Subcollection) ---
      match /outreach/{outreachId} {
        function isValidOutreach(data) {
          return data.contactId == contactId &&
                 (data.createdBy == request.auth.uid || isAdmin()) &&
                 data.status in ['draft', 'sent', 'manual', 'wont-send'] &&
                 (!data.keys().hasAny(['emailBody']) || (data.emailBody is string && data.emailBody.size() <= 10000)) &&
                 (!data.keys().hasAny(['subject']) || (data.subject is string && data.subject.size() <= 700)) &&
                 (!data.keys().hasAny(['type']) || (data.type is string && data.type.size() <= 100)) &&
                 (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 10000)) &&
                 (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 10000)) &&
                 (!data.keys().hasAny(['hasResponse']) || data.hasResponse is bool) &&
                 (!data.keys().hasAny(['createdAt']) || data.createdAt is string) &&
                 (!data.keys().hasAny(['updatedAt']) || data.updatedAt is string) &&
                 (!data.keys().hasAny(['docUrl']) || data.docUrl is string);
        }

        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(outreachId) && isValidOutreach(incoming());
        allow update: if isSignedIn() && (
          (isValidOutreach(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'docUrl', 'subject', 'type', 'description', 'notes', 'hasResponse', 'updatedAt'])) ||
          isAdmin()
        );
        allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
      }
    }

    // --- 4. Discoveries ---
    match /discoveries/{discoveryId} {
      function isValidDiscovery(data) {
        return data.companyName is string && data.companyName.size() <= 100 &&
               data.companyUrl is string && data.companyUrl.size() <= 200 &&
               data.createdBy == request.auth.uid &&
               data.createdAt is string;
      }

      allow read: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(discoveryId) && isValidDiscovery(incoming());
      allow update: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['criteria', 'results', 'personaId'])
      );
      allow delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // --- 7. Companies ---
    match /companies/{companyId} {
      function isValidCompany(data) {
        return data.name is string && data.name.size() <= 200 &&
               (!data.keys().hasAny(['url']) || data.url is string) &&
               (!data.keys().hasAny(['latestIntelligence']) || data.latestIntelligence is string) &&
               data.createdBy == request.auth.uid;
      }
      allow read: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(companyId) && isValidCompany(incoming());
      allow update: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['latestIntelligence', 'summary', 'personaId', 'updatedAt']) && isValidCompany(incoming())
      );
      allow delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());

      // --- 7.1 Reports (Subcollection) ---
      match /reports/{reportId} {
        function isValidReport(data) {
          return data.content is string && data.createdBy == request.auth.uid;
        }
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(reportId) && isValidReport(incoming());
        allow delete: if isAdmin();
      }
    }

    // --- 8. Bulk Discoveries ---
    match /bulkDiscoveries/{batchId} {
      function isValidBatch(data) {
        return data.createdBy == request.auth.uid &&
               data.createdAt is string;
      }
      allow read: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(batchId) && isValidBatch(incoming());
      allow update: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['status', 'processed', 'results'])
      );
      allow delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // --- 9. Prompts ---
    match /prompts/{promptId} {
      function isValidPrompt(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.template is string && data.template.size() <= 10000 &&
               data.updatedAt is string;
      }

      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidPrompt(incoming());
    }

    // --- 6. Global Settings ---
    match /settings/{settingId} {
      function isValidSetting(data) {
        return data.id == settingId &&
               data.defaultDiscoveryRequirements is string &&
               data.defaultDiscoveryRequirements.size() <= 5000;
      }

      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidSetting(incoming());
    }
  }
}
